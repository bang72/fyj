# MIVO V5 — Vercel / local server environment
# Copy to .env.local for local development. Never commit real secrets.

# Required: PostgreSQL/Neon connection string (TLS in production).
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Required: three different random secrets, each at least 32 characters.
AUTH_SECRET=
SECURITY_PEPPER=
PASSWORD_PEPPER=

# Public application origin used for redirects and payment return URLs.
APP_ORIGIN=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta

# Optional realtime provider. Without this, MIVO uses persistent adaptive polling.
ABLY_API_KEY=

# Optional paid plans. Leave all Stripe values empty to disable billing safely.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring IDR monthly prices: PLUS Rp20.000, MAX Rp30.000.
STRIPE_PRICE_PLUS=
STRIPE_PRICE_MAX=

# Optional private object storage (S3-compatible) for profile photos.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional one-time token to promote the first ADMIN account.
ADMIN_BOOTSTRAP_TOKEN=

# Optional but recommended: create exactly one initial ADMIN account when
# `npm run db:migrate` (or `npm run admin:bootstrap`) is run.
# Keep these values only in Vercel/local environment variables, never GitHub.
MIVO_ADMIN_USERNAME=mivo.owner
MIVO_ADMIN_PASSWORD=
MIVO_ADMIN_ALIAS=MIVO Owner

# V5 operational defaults are stored in the database by migration 0004.
# Use /admin/v5 after login as ADMIN to pause matchmaking/messages/media,
# enable maintenance mode, roll out feature flags, and publish announcements.
